# Server operator only. Extension users enter their personal key in Settings.
QUIZ_DAILY_REQUEST_LIMIT=10
# Generate a random 32-byte base64 encryption key. Never embed it in the extension.
PLOTTWIST_CONFIG_ENCRYPTION_KEY=
# Single-server development: npm run setup:storage initializes this private directory.
PLOTTWIST_CONFIG_DIRECTORY=
# Vercel / multiple instances: dedicated Upstash-compatible Redis REST storage.
PLOTTWIST_CONFIG_REDIS_URL=
PLOTTWIST_CONFIG_REDIS_TOKEN=
